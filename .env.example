RHYTHM_SERVICE_APP_PORT=8001
# Inside Docker container: bvc-postgres:5432. Localhost from host machine: localhost:5432
RHYTHM_SERVICE_DATABASE_URL=postgresql+psycopg://bvc_admin:your-postgres-password@bvc-postgres:5432/bachvietcam_rhythm_staging
# RabbitMQ Cloud AMQP URL, for example: amqps://user:password@host.cloudamqp.com/vhost
RHYTHM_SERVICE_RABBITMQ_URL=amqps://user:password@your-rabbitmq-cloud-host/vhost
RHYTHM_SERVICE_RHYTHM_TASK_QUEUE=rhythm.evaluate.v1
RHYTHM_SERVICE_RHYTHM_DEAD_LETTER_QUEUE=rhythm.evaluate.dlq
RHYTHM_SERVICE_INTERNAL_API_KEY=replace-with-a-long-random-value
# Must match BVC-BE AI_CALLBACK_SECRET. Used only for Rhythm → BE progress callbacks.
RHYTHM_SERVICE_CALLBACK_SECRET=replace-with-the-be-callback-secret
RHYTHM_SERVICE_CALLBACK_TIMEOUT_SECONDS=5
RHYTHM_SERVICE_CALLBACK_MAX_RETRIES=2
# Optional comma-separated backend callback host allowlist. Empty accepts any HTTP(S) callback host.
RHYTHM_SERVICE_CALLBACK_ALLOWED_HOSTS=
RHYTHM_SERVICE_GEMINI_API_KEY=
RHYTHM_SERVICE_GEMINI_MODEL=gemini-3.6-flash
RHYTHM_SERVICE_GEMINI_TIMEOUT_SECONDS=500
RHYTHM_SERVICE_MAX_FILE_BYTES=26214400
RHYTHM_SERVICE_DOWNLOAD_TIMEOUT_SECONDS=60
RHYTHM_SERVICE_MAX_RETRIES=3
RHYTHM_SERVICE_TEMP_DIRECTORY=/tmp/rhythm-service
# Optional comma-separated storage host allowlist. Empty means any public host.
RHYTHM_SERVICE_ALLOWED_HOSTS=

# Template MAIN: one worker also consumes the evaluation queue.
RHYTHM_SERVICE_TEMPLATE_TASK_QUEUE=rhythm.template.analyze.v1
RHYTHM_SERVICE_TEMPLATE_DEAD_LETTER_QUEUE=rhythm.template.analyze.dlq
# Persistent JSON artifacts. Docker Compose mounts a named volume here.
# For local Python on Windows, a path such as ./artifacts can be used.
RHYTHM_SERVICE_ARTIFACT_ROOT=/data/rhythm-artifacts
