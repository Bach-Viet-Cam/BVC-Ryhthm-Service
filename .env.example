APP_PORT=8001
DATABASE_URL=postgresql+psycopg://rhythm:rhythm@rhythm-db:5432/rhythm
# RabbitMQ Cloud AMQP URL, for example: amqps://user:password@host.cloudamqp.com/vhost
RABBITMQ_URL=amqps://user:password@your-rabbitmq-cloud-host/vhost
RHYTHM_TASK_QUEUE=rhythm.evaluate.v1
RHYTHM_DEAD_LETTER_QUEUE=rhythm.evaluate.dlq
INTERNAL_API_KEY=replace-with-a-long-random-value
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
MAX_FILE_BYTES=26214400
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_RETRIES=3
TEMP_DIRECTORY=/tmp/rhythm-service
# Optional comma-separated storage host allowlist. Empty means any public host.
ALLOWED_HOSTS=
